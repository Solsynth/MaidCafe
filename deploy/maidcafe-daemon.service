[Unit]
Description=MaidCafe MaidKit daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=maidcafe
Group=maidcafe
ExecStart=/usr/local/bin/maidcafe-daemon --config /etc/maidcafe/config.toml
# `systemctl reload` sends SIGHUP; the daemon re-reads its configuration and
# fragments and swaps every reloadable component without a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Keep the daemon's configuration and executable immutable at runtime while
# allowing configured scripts to use the dedicated state directory.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# /etc/maidcafe must be writable for the config API (PATCH /api/v1/config
# writes config.toml) and for user-switching action scripts (rendered under
# /etc/maidcafe/actions/run). User-switching actions and the root-visibility
# sudo -n retries additionally need NoNewPrivileges=false plus a
# passwordless sudoers rule for the maidcafe user.
#
# A privileged file root (daemon.files.roots with privileged = true) reaches
# root through the maidkit-priv helper, which runs inside this namespace: a
# root under a path this unit makes read-only (ProtectSystem covers /etc and
# /usr) must be listed here as well, and NoNewPrivileges must be false for
# sudo.
#
# The same applies to the other three privileged families the helper serves —
# systemd units, packages and firewall rules — and each writes more than a
# file root does: package management writes /var/lib/dpkg and /var/cache/apt,
# ufw writes /etc/ufw, firewalld writes /etc/firewalld. That list is the tools'
# own storage, and it is why a host using those families is usually better
# served by ProtectSystem=true than by enumerating them. See
# docs/PRIVILEGED.md, "The systemd sandbox".
ReadWritePaths=/etc/maidcafe
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
