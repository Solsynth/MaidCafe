[Unit]
Description=MaidCafe MaidKit daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=maidcafe
Group=maidcafe
ExecStart=/usr/local/bin/maidcafe-daemon --config /etc/maidcafe/config.toml
# `systemctl reload` sends SIGHUP; the daemon re-reads its configuration and
# fragments and swaps every reloadable component without a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Keep the daemon's configuration and executable immutable at runtime while
# allowing configured scripts to use the dedicated state directory.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# /etc/maidcafe must be writable for the config API (PATCH /api/v1/config
# writes config.toml) and for user-switching action scripts (rendered under
# /etc/maidcafe/actions/run). User-switching actions and the root-visibility
# sudo -n retries additionally need NoNewPrivileges=false plus a
# passwordless sudoers rule for the maidcafe user.
ReadWritePaths=/etc/maidcafe
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
